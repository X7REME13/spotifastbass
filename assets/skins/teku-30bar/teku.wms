            value="wmpprop:eq.gainLevel9" value_onChange="eq.gainLevel9=value;" cursor="hand"/>
    <SLIDER id="band26" left="424" top="70" width="9" height="96" direction="vertical"
            min="-12" max="12" backgroundImage="seek_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png"
            value="wmpprop:eq.gainLevel9" value_onChange="eq.gainLevel9=value;" cursor="hand"/>
    <SLIDER id="band27" left="440" top="70" width="9" height="96" direction="vertical"
            min="-12" max="12" backgroundImage="seek_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png"
            value="wmpprop:eq.gainLevel9" value_onChange="eq.gainLevel9=value;" cursor="hand"/>
    <SLIDER id="band28" left="456" top="70" width="9" height="96" direction="vertical"
            min="-12" max="12" backgroundImage="seek_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png"
            value="wmpprop:eq.gainLevel10" value_onChange="eq.gainLevel10=value;" cursor="hand"/>
    <SLIDER id="band29" left="472" top="70" width="9" height="96" direction="vertical"
            min="-12" max="12" backgroundImage="seek_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png"
            value="wmpprop:eq.gainLevel10" value_onChange="eq.gainLevel10=value;" cursor="hand"/>
    <SLIDER id="band30" left="488" top="70" width="9" height="96" direction="vertical"
            min="-12" max="12" backgroundImage="seek_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png"
            value="wmpprop:eq.gainLevel10" value_onChange="eq.gainLevel10=value;" cursor="hand"/>
    <TEXT left="24" top="174" width="100" height="14" fontSize="7" foregroundColor="#00e5ff" value="25Hz [SUB-BASS]"/>
    <TEXT left="240" top="174" width="80" height="14" fontSize="7" foregroundColor="#00ff88" value="1kHz [MID]"/>
    <TEXT left="460" top="174" width="60" height="14" fontSize="7" foregroundColor="#ff6e00" value="20kHz [HIGH]"/>
  </SUBVIEW>

</VIEW>
</THEME>
